ALERT_EMAIL_TO=sheng.chi@qq.com
ALERT_EMAIL_FROM=Signal Alerts <alerts@your-domain.com>
CRON_SECRET=replace-with-a-long-random-secret
DASHBOARD_SECRET=replace-with-a-separate-query-password

# Pick one provider for production email delivery.
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Supabase is used for duplicate prevention and run logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signal-only density controls. Strong observation email is opt-in and scoped
# only to dynamic_relative_strength_breakout observations.
SIGNAL_DYNAMIC_STRENGTH_OBSERVATION_EMAIL_ENABLED=false
MAX_SIGNALS_PER_EMAIL=4
DYNAMIC_STRONG_POOL_MAX_ASSETS=25
